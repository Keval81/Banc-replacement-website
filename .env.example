# Banc Property Group — Environment Variables
# Copy this to .env.local and fill in your credentials

# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# OpenAI (Conversational Property Assistant)
# ============================================
OPENAI_API_KEY=
# Must support the Responses API with strict json_schema structured output.
# Verified working: gpt-4.1 (fastest end to end), gpt-4.1-mini, gpt-4o-mini.
# The gpt-5 models work but spend 300-560 reasoning tokens per call and run
# 2-4x slower, which the handler multiplies by up to three calls per turn.
OPENAI_CHAT_MODEL=gpt-4.1

# ============================================
# Expert Agent CRM
# ============================================
EXPERT_AGENT_API_URL=
EXPERT_AGENT_API_KEY=
EXPERT_AGENT_FTP_URL=
EXPERT_AGENT_FTP_USER=
EXPERT_AGENT_FTP_PASS=

# ============================================
# Rightmove BLM Feed
# ============================================
RIGHTMOVE_NETWORK_ID=
RIGHTMOVE_BRANCH_ID=
RIGHTMOVE_FTP_HOST=
RIGHTMOVE_FTP_USER=
RIGHTMOVE_FTP_PASSWORD=

# ============================================
# Resend (Email)
# ============================================
RESEND_API_KEY=

# ============================================
# Sanity CMS
# ============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=

# ============================================
# Auth (NextAuth)
# ============================================
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ============================================
# Google (Reviews, Maps)
# ============================================
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
